# Copy this file to .env and fill it in. Never commit .env.

# --- Claude (https://platform.claude.com -> API keys)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# --- WhatsApp Business Cloud API (https://developers.facebook.com -> your app -> WhatsApp -> API Setup)
# Permanent token from a System User in Meta Business Settings (the temporary 24h token works for testing)
WHATSAPP_TOKEN=
# "Phone number ID" shown on the API Setup page (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; paste the same value in Meta's webhook "Verify token" box
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret (used to check that webhooks really come from Meta)
META_APP_SECRET=

# --- Behaviour
# Busy mode is switched on the dashboard ("I'm busy" / "I'm back"); while busy, every reply goes out on its own.
# When you're not busy: approve = every reply waits for you on the dashboard; auto = send unless the draft needs you
REPLY_MODE=approve
# Optional: change the "this is an AI assistant" notice sent at the start of each conversation
# AI_NOTICE_AR=
# AI_NOTICE_EN=
# NOTICE_GAP_HOURS=24
# true = log replies instead of sending them. Set to false only when you're ready to go live.
DRY_RUN=true
HISTORY_MESSAGES=20

# --- Dashboard login (username can be anything)
DASHBOARD_PASSWORD=
